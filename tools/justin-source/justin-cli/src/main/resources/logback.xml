<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="sootup" level="WARN"/>
  <logger name="cn.ac.ios.justin.symexec" level="${justin.symlog:-INFO}"/>
  <logger name="cn.ac.ios.justin" level="${justin.log:-INFO}"/>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
